{
  "name": "artificial-brain-v3",
  "version": "3.0.0",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev:server": "nodemon server.js",
    "dev:app": "node -e \"setTimeout(()=>import('child_process').then(c=>c.execSync('npx vite',{stdio:'inherit'})),6000)\"",
    "dev:genesis": "node -e \"setTimeout(()=>import('child_process').then(c=>c.execSync('npx vite',{stdio:'inherit',cwd:'apps/genesis'})),6000)\"",
    "dev": "concurrently -n server,app,genesis -c blue,green,magenta \"npm run dev:server\" \"npm run dev:app\" \"npm run dev:genesis\"",
    "build": "tsc -b && vite build",
    "build:all": "npm run build && cd apps/genesis && npx vite build --outDir ../../public/genesis && cd ../businesses && npx vite build --outDir ../../public/businesses && cd ../inventor-studio && npx vite build --outDir ../../public/inventor-studio",
    "build:genesis": "cd apps/genesis && npx vite build --outDir ../../public/genesis",
    "build:businesses": "cd apps/businesses && npx vite build --outDir ../../public/businesses",
    "build:inventor": "cd apps/inventor-studio && npx vite build --outDir ../../public/inventor-studio",
    "start": "node server.js",
    "lint": "tsc --noEmit",
    "agent": "cd local-agent && node agent.js"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@splinetool/react-spline": "^4.1.0",
    "@splinetool/runtime": "^1.12.92",
    "axios": "^1.7.7",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "framer-motion": "^12.38.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.460.0",
    "mammoth": "^1.12.0",
    "mongoose": "^8.8.1",
    "neo4j-driver": "^5.27.0",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.184.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "nodemon": "^3.1.7",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
