# Artificial Brain v3 — Docker Tunnel Environment

# Auth token for Caddy gate (all services use same token)
AUTH_TOKEN=your_secret_auth_token_here

# Cloudflare Tunnel token (from Cloudflare Zero Trust dashboard)
CLOUDFLARED_TOKEN=your_cloudflare_tunnel_token_here

# Neo4j password
NEO4J_PASSWORD=brain_password

# Tunnel URLs exposed by Cloudflare:
#   ollama.klabs.network  → port 80  → Ollama (4 LLM models)
#   neo4j.klabs.network   → port 81  → Neo4j (knowledge graph + memory)
#   sim.klabs.network     → port 82  → MuJoCo Simulator (Unitree G1)
#   rl.klabs.network      → port 83  → Cerebellum RL (SmolVLA + REINFORCE)
