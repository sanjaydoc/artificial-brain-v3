# ── Artificial Brain v3 — Environment Variables ──────────────────────────────

# Server
PORT=3003
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ── LLM Providers (tier order) ───────────────────────────────────────────────
LLM_PROVIDER_ORDER=openrouter,nvidia,ollamaTunnel,ollamaLocal

# Tier 1: OpenRouter (cloud primary)
OPENROUTER_API_KEY=
OPENROUTER_REASONING_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_LANGUAGE_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small

# Tier 2: NVIDIA NIM (cloud fallback)
NVIDIA_API_KEY=

# Tier 3: Ollama Tunnel (self-hosted via Docker + Cloudflare)
OLLAMA_TUNNEL_URL=https://ollama.klabs.network
OLLAMA_TUNNEL_AUTH_TOKEN=

# Tier 4: Ollama Local (dev only)
OLLAMA_LOCAL_URL=http://localhost:11434

# Ollama model names (used by tunnel + local)
OLLAMA_REASONING_MODEL=qwen2.5:7b
OLLAMA_LANGUAGE_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
OLLAMA_VISION_MODEL=moondream:latest
OLLAMA_CODER_MODEL=qwen2.5-coder:7b

# Circuit breaker
LLM_FAIL_THRESHOLD=3
LLM_COOLDOWN_MS=300000

# ── Neo4j (knowledge graph + episodic memory) ───────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=brain_password

# ── Simulator (MuJoCo via tunnel) ───────────────────────────────────────────
SIM_TUNNEL_URL=https://sim.klabs.network
TUNNEL_AUTH_TOKEN=

# ── Reinforcement Learning (SmolVLA via tunnel) ─────────────────────────────
RL_TUNNEL_URL=https://rl.klabs.network

# ── Authentication ──────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password

# ── MongoDB ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/dbname

# ── Business API Integrations (for Genesis agent tools) ─────────────────────

# Google Calendar — console.cloud.google.com → Calendar API → OAuth2 token
GOOGLE_OAUTH_TOKEN=
GOOGLE_CALENDAR_API_KEY=

# HubSpot CRM — app.hubspot.com → Settings → Integrations → Private App
HUBSPOT_TOKEN=

# Salesforce — developer.salesforce.com → Connected App → OAuth
SALESFORCE_TOKEN=
SALESFORCE_INSTANCE_URL=https://yourorg.my.salesforce.com

# Stripe Payments — dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# QuickBooks Online — developer.intuit.com → OAuth2 token
QUICKBOOKS_TOKEN=
QUICKBOOKS_REALM_ID=
QUICKBOOKS_BASE_URL=https://quickbooks.api.intuit.com

# Twilio SMS — twilio.com/console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
